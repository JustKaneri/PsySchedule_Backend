{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error",
        "Microsoft.AspNetCore.Hosting": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "PsyScheduleApi"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PsySchedule": "Host=localhost;Port=5433;Database=PsySchedule;Username=postgres;Password=12345"
  },
  "Jwt": {
    "Key": "ThisIsTheMostSecretKeyInTheWorld",
    "ExpireTime": "00:03:00",
    "ExpireTimeRefresh": "1",
    "ValidIssuer": "PsyShedule",
    "ValidateIssuer": false, //false for dev, true for prod
    "ValidateAudience": false, //false for dev, true for prod
    "ValidateLifetime": false //false for dev, true for prod
  }
}
